# Required
GEMINI_API_KEY=your_key
# Local SearXNG (docker-compose.yml)
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=generate-a-random-string
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
MIN_MATCH_SCORE=50
DAILY_EMAIL_LIMIT=20
SEARCH_MIN_INTERVAL_SEC=20
QUERIES_PER_PASS=12
WEB_PORT=8765
# Funded-startups tab: only rounds announced within this many days
FUNDING_WINDOW_DAYS=30
# Daily run (python run.py --daily) — see docs/DAILY_CLOUD_RUN.md
DAILY_RUN_MINUTES=35
# Use a private data repo clone for the database/resumes (laptop + daily cloud run share it)
# DATA_DIR=/path/to/job-agent-runner/data
# RESUMES_DIR=/path/to/job-agent-runner/resumes
# DATA_REPO_SYNC=1
